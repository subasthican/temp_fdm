            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Create a product. Access: admin, manager.\n\npricingMode: 'batch' (MRP from FEFO batch) | 'product' (per-store price). sellType: 'each' | 'weighed'. taxClassId nullable (defaults to Exempt). SKU + barcodes unique across catalog.",
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"Sugar 1kg\",\n    \"sku\": \"SUG1KG\",\n    \"barcodes\": [\"{{barcode}}\"],\n    \"categoryId\": \"{{categoryId}}\",\n    \"brandId\": null,\n    \"imageUrl\": \"\",\n    \"sellType\": \"each\",\n    \"pricingMode\": \"batch\",\n    \"baseUnit\": \"pcs\",\n    \"taxClassId\": null,\n    \"isAgeRestricted\": false\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["try { var p = pm.response.json().data.product; if (p && p.id) pm.collectionVariables.set('productId', p.id); } catch (e) {}"] } }
          ]
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id"], "variable": [{ "key": "id", "value": "{{productId}}" }] },
            "description": "Get a product by ID, including its per-store prices."
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id"], "variable": [{ "key": "id", "value": "{{productId}}" }] },
            "description": "Update a product (whitelisted fields incl. isActive). Access: admin, manager.",
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"Sugar 1kg (white)\",\n    \"isActive\": true\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Set Per-store Price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/:id/prices", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id", "prices"], "variable": [{ "key": "id", "value": "{{productId}}" }] },
            "description": "Upsert a store's price for the product. Access: admin, manager. For batch-priced items this is a fallback; batch MRP wins at billing.",
            "body": { "mode": "raw", "raw": "{\n    \"storeId\": \"{{storeId}}\",\n    \"cost\": 95,\n    \"sellPrice\": 110,\n    \"reorderLevel\": 20\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Generate Barcode",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/:id/barcode", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id", "barcode"], "variable": [{ "key": "id", "value": "{{productId}}" }] },
            "description": "Mint/assign a barcode into product.barcodes[]. Access: admin, manager. format: 'ean13' (in-store EAN-13, minted) | 'code128' (encodes the SKU).",
            "body": { "mode": "raw", "raw": "{\n    \"format\": \"ean13\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Delete Product (soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id"], "variable": [{ "key": "id", "value": "{{productId}}" }] },
            "description": "Soft-delete a product (hidden from catalog, search and checkout; sale/stock history kept). Access: admin only."
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Receive Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/receive", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "receive"] },
            "description": "Receive stock — creates a batch (with expiry + MRP), bumps on-hand, logs a movement. Access: admin, manager. Leave batchNo blank to auto-generate (<SKU>-B<seq>). Shared path reused by goods-receipt later.",
            "body": { "mode": "raw", "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"storeId\": \"{{storeId}}\",\n    \"batchNo\": \"\",\n    \"expiryDate\": \"2026-12-31\",\n    \"cost\": 95,\n    \"sellPrice\": 110,\n    \"quantity\": 100\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["try { var b = pm.response.json().data.batch; if (b && b.id) pm.collectionVariables.set('batchId', b.id); } catch (e) {}"] } }
          ]
        },
        {
          "name": "Adjust Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "adjust"] },
            "description": "Adjust stock by a signed delta (negative removes). Access: admin, manager. reason: damage | wastage | count_correction | expiry | theft | other. Optional batchId targets a specific batch.",
            "body": { "mode": "raw", "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"storeId\": \"{{storeId}}\",\n    \"delta\": -8,\n    \"reason\": \"damage\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "List Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/stock/list", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "stock", "list"] },
            "description": "Per-store on-hand list with low-stock flag. Body: page, limit, search, storeId.",
            "body": { "mode": "raw", "raw": "{\n    \"storeId\": \"{{storeId}}\",\n    \"search\": \"\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "List Batches",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/batches/list", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "batches", "list"] },
            "description": "Batches (FEFO order — earliest expiry first). Body: page, limit, productId, storeId, inStock.",
            "body": { "mode": "raw", "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"inStock\": true\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "List Movements",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/movements/list", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "movements", "list"] },
            "description": "Append-only stock movement ledger. Body: page, limit, productId, storeId, type (receive|sale|return|adjustment|wastage|transfer_out|transfer_in).",
            "body": { "mode": "raw", "raw": "{\n    \"productId\": \"{{productId}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Sales / Checkout",
      "item": [
        {
          "name": "Lookup Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sales/lookup", "host": ["{{baseUrl}}"], "path": ["api", "sales", "lookup"] },
            "description": "Resolve a scanned/searched item for the cart: product + unit price + (for batch-priced) all in-stock batches in FEFO order. Access: any authenticated. Provide barcode OR productId, plus storeId.",
            "body": { "mode": "raw", "raw": "{\n    \"storeId\": \"{{storeId}}\",\n    \"barcode\": \"{{barcode}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Complete Sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sales", "host": ["{{baseUrl}}"], "path": ["api", "sales"] },
            "description": "Complete a sale. Access: any authenticated. IDEMPOTENT on clientSaleId (a UUID — a retry returns the original sale, never double-posts). Server re-resolves each line's authoritative price from its batch / per-store price, decrements stock + batches, mints the receipt number, and computes change. payments[].method: cash | card | wallet.",
            "body": { "mode": "raw", "raw": "{\n    \"clientSaleId\": \"{{$guid}}\",\n    \"storeId\": \"{{storeId}}\",\n    \"registerId\": \"{{registerId}}\",\n    \"lines\": [\n        {\n            \"productId\": \"{{productId}}\",\n            \"batchId\": \"{{batchId}}\",\n            \"barcode\": \"{{barcode}}\",\n            \"quantity\": 2\n        }\n    ],\n    \"payments\": [\n        { \"method\": \"cash\", \"amount\": 500 }\n    ]\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["try { var s = pm.response.json().data.sale; if (s && s.id) pm.collectionVariables.set('saleId', s.id); } catch (e) {}"] } }
          ]
        },
        {
          "name": "Get Sale (receipt)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sales/:id", "host": ["{{baseUrl}}"], "path": ["api", "sales", ":id"], "variable": [{ "key": "id", "value": "{{saleId}}" }] },
            "description": "Full receipt payload for one sale (store header/footer, register, cashier, lines, totals, payments, change). Used for on-screen receipt + reprint."
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Dashboard",
          "request": {
