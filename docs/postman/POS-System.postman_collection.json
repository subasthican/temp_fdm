            "url": { "raw": "{{baseUrl}}/api/reports/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "reports", "dashboard"] },
            "description": "Dashboard analytics. Access: admin, manager. Returns summary (revenue, salesCount, itemsSold, averageBasket), tender split (cash nets change), top products, daily sales series, and a current stock snapshot (units, value, low-stock, SKUs). Body: storeId, from, to (ISO dates) — all optional (omit for all-time / all-stores).",
            "body": { "mode": "raw", "raw": "{\n    \"storeId\": \"{{storeId}}\",\n    \"from\": \"2026-07-01\",\n    \"to\": \"2026-07-31\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
