{
  "info": {
    "_postman_id": "pos-system-grocery-api-v1",
    "name": "POS System API (Grocery / Supermarket)",
    "description": "API collection for the multi-store, offline-capable grocery POS backend (MERN).\n\nBase URL: {{baseUrl}} (default http://localhost:5000). Every route lives under /api; health probe is /api/health.\n\nHeaders:\n- Content-Type: application/json (JSON requests)\n- Authorization: Bearer {{accessToken}} (all except login, refresh, health)\n\nAuth model: short-lived JWT access token + rotating refresh token. Refresh tokens are persisted on the user, matched + rotated on every /auth/refresh, and cleared on logout and password change. Login/Refresh test scripts auto-save data.accessToken and data.refreshToken into collection variables.\n\nResponse envelope: { success, message, data }. Lists use POST /<resource>/list with page/limit/search in the JSON body (GET bodies are dropped by proxies).\n\nRoles: admin | manager | cashier. Each request description states its access level.\n\nSeeded admin: admin / Admin@123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "username", "value": "admin", "type": "string" },
    { "key": "password", "value": "Admin@123", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "storeId", "value": "", "type": "string" },
    { "key": "registerId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "brandId", "value": "", "type": "string" },
    { "key": "taxClassId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "batchId", "value": "", "type": "string" },
    { "key": "saleId", "value": "", "type": "string" },
    { "key": "barcode", "value": "8901234567890", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Login with username + password. No auth header. Test script auto-saves data.accessToken and data.refreshToken. Body: username, password (min 8 chars).",
            "body": { "mode": "raw", "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  if (res.data.accessToken) { pm.collectionVariables.set('accessToken', res.data.accessToken); console.log('accessToken saved'); }",
                  "  if (res.data.refreshToken) { pm.collectionVariables.set('refreshToken', res.data.refreshToken); console.log('refreshToken saved'); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "description": "Rotate the refresh token. Response carries a NEW access + refresh pair; the old refresh token dies immediately. No auth header. Test script auto-saves both.",
            "body": { "mode": "raw", "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  if (res.data.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  if (res.data.refreshToken) pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Logout — clears the stored refresh token server-side. No body."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Current authenticated user profile."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Update own profile. Only fullName / email / phone accepted (whitelisted).",
            "body": { "mode": "raw", "raw": "{\n    \"fullName\": \"System Admin\",\n    \"email\": \"admin@nexuspos.lk\",\n    \"phone\": \"0771234567\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] },
            "description": "Change password. Clears the refresh token — every session must log in again.",
            "body": { "mode": "raw", "raw": "{\n    \"currentPassword\": \"{{password}}\",\n    \"newPassword\": \"NewPass@123\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Stores",
      "item": [
        {
          "name": "List Stores",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/stores/list", "host": ["{{baseUrl}}"], "path": ["api", "stores", "list"] },
            "description": "List stores (paginated). Access: any authenticated (cashiers list to bind a terminal). Body: page, limit, search, isActive (all optional).",
            "body": { "mode": "raw", "raw": "{\n    \"page\": 1,\n    \"limit\": 20,\n    \"search\": \"\",\n    \"isActive\": true\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { var rows = pm.response.json().data.data; if (rows && rows[0]) pm.collectionVariables.set('storeId', rows[0].id); } catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/stores", "host": ["{{baseUrl}}"], "path": ["api", "stores"] },
            "description": "Create a store. Access: admin. code is unique.",
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"Main Branch\",\n    \"code\": \"MB\",\n    \"address\": \"123 Main Street, Colombo\",\n    \"phone\": \"0112223344\",\n    \"currency\": \"Rs.\",\n    \"taxProfile\": { \"isInclusive\": true },\n    \"receipt\": { \"header\": \"\", \"footer\": \"Thank you!\", \"logoUrl\": \"\" }\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { var s = pm.response.json().data.store; if (s && s.id) pm.collectionVariables.set('storeId', s.id); } catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Store",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/stores/:id", "host": ["{{baseUrl}}"], "path": ["api", "stores", ":id"], "variable": [{ "key": "id", "value": "{{storeId}}" }] },
            "description": "Get a store by ID."
          }
        },
        {
          "name": "Update Store",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/stores/:id", "host": ["{{baseUrl}}"], "path": ["api", "stores", ":id"], "variable": [{ "key": "id", "value": "{{storeId}}" }] },
            "description": "Update a store (whitelisted fields incl. isActive). Access: admin.",
            "body": { "mode": "raw", "raw": "{\n    \"phone\": \"0112223355\",\n    \"receipt\": { \"footer\": \"Thank you, come again!\" }\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Deactivate Store",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/stores/:id", "host": ["{{baseUrl}}"], "path": ["api", "stores", ":id"], "variable": [{ "key": "id", "value": "{{storeId}}" }] },
            "description": "Soft-deactivate a store (isActive=false; history kept). Access: admin."
          }
        }
      ]
    },
